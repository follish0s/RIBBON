#version 460 core
// Ribbon FSR 2.2 — 时域累积 Pass
// 输入：当前帧颜色、屏幕空间速度、上一帧历史；输出：新历史（=累积结果）
// 每个 dispatch 线程对应"显示分辨率"上的一个像素。

layout(local_size_x = 8, local_size_y = 8) in;

// 写入：新历史（RGBA16F，显示分辨率）
layout(binding = 0, rgba16f) writeonly uniform image2D u_historyOut;

// 采样：当前帧颜色（主渲染目标颜色纹理，渲染分辨率）
uniform sampler2D u_currentColor;   // texture unit 0
// 采样：屏幕空间速度（RG16F，渲染分辨率），xy = currUV - prevUV（归一化 UV 单位）
uniform sampler2D u_velocity;       // texture unit 1
// 采样：上一帧历史（RGBA16F，显示分辨率）
uniform sampler2D u_historyPrev;   // texture unit 2

uniform vec2  u_renderSize;    // 渲染分辨率（源）
uniform vec2  u_displaySize;   // 显示/历史分辨率（目标）
uniform float u_historyWeight;// 历史权重 [0,1]，越高越稳定
uniform int   u_firstFrame;    // 1 = 首帧/历史失效，直接采用当前帧
uniform float u_velocityClampPix; // 速度超过这么多像素则判定为运动过大，降低历史权重
uniform float u_maxVelocityLength;// 速度(UV 单位)超过此阈值则强制断代（historyWeight→0）
uniform float u_clipBoxShrink;    // AABB 钳制盒收缩系数(如 0.95)，越小裁剪越紧越抗拖影

const float EPS = 1.0e-4;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pix, ivec2(u_displaySize)))) return;

    vec2 displayTexel = 1.0 / u_displaySize;
    vec2 renderTexel  = 1.0 / u_renderSize;
    vec2 outUV = (vec2(pix) + 0.5) / u_displaySize;     // 显示像素中心
    // 速度纹理与当前帧都在渲染分辨率；用 outUV 采样即自动双线性放大
    vec2 vel = texture(u_velocity, outUV).xy;
    float velLenUV = length(vel);                        // UV 单位速度长度
    float velLenPix = velLenUV * u_renderSize.x;         // 像素单位速度长度

    vec3 curr = texture(u_currentColor, outUV).rgb;

    // 历史重投影采样位置：把当前像素的"世界点"在上一帧对应到 prevUV
    vec2 histUV = outUV - vel;
    bool valid = all(greaterThanEqual(histUV, vec2(0.0)))
              && all(lessThanEqual(histUV, vec2(1.0)));

    vec3 outCol;
    if (u_firstFrame != 0 || !valid) {
        // 首帧 / 越界（相机大幅移动/新暴露区域）：直接采用当前帧
        outCol = curr;
    } else {
        vec3 hist = texture(u_historyPrev, histUV).rgb;

        // 速度阈值强制断代：物体极速运动/场景剧变时，历史完全不可信，
        // 直接丢弃历史只显示当前帧，避免严重撕裂与鬼影。
        if (velLenUV > max(u_maxVelocityLength, EPS)) {
            outCol = curr;
            imageStore(u_historyOut, pix, vec4(outCol, 1.0));
            return;
        }

        // 3x3 邻域 clamp（逐通道）
        vec3 cmin = vec3(1e9), cmax = vec3(-1e9);
        for (int j = -1; j <= 1; ++j)
            for (int i = -1; i <= 1; ++i) {
                vec3 s = texture(u_currentColor, outUV + vec2(float(i), float(j)) * renderTexel).rgb;
                cmin = min(cmin, s); cmax = max(cmax, s);
            }

        // 收紧钳制盒：以邻域颜色均值为中心，向中心收缩，再叠加极小容差。
        // 收缩后历史颜色被更严格地 clamp 在更窄范围里，有效消灭高频闪烁与拖影。
        vec3 mid = (cmin + cmax) * 0.5;
        vec3 halfExt = (cmax - cmin) * 0.5 * u_clipBoxShrink + vec3(1.0e-3);
        vec3 lo = mid - halfExt;
        vec3 hi = mid + halfExt;
        vec3 histClamped = clamp(hist, lo, hi);

        // 运动越大历史越不可信：在静止区 alpha 接近 u_historyWeight，
        // 在高速运动区降低以避免拖影。
        float motionConfidence = 1.0 - clamp(velLenPix / max(u_velocityClampPix, EPS), 0.0, 1.0);
        float alpha = u_historyWeight * motionConfidence;

        outCol = mix(curr, histClamped, alpha);
    }

    // NaN 防护：极端场景下历史或当前帧可能产生 NaN，写回安全值
    if (any(isnan(outCol)) || any(isinf(outCol))) outCol = curr;

    imageStore(u_historyOut, pix, vec4(outCol, 1.0));
}
